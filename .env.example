# ---------------------------------------------------------------------------
# ZeNOxWeb.ir — نمونه فایل محیطی
# ---------------------------------------------------------------------------

# اتصال به PostgreSQL (در داکر: postgres://postgres:postgres@postgres:5432/zenoxweb)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# کلید امضای توکن نشست (حتما در پروداکشن تغییر دهید)
AUTH_SECRET=change-me-to-a-long-random-string

# آدرس عمومی سایت (برای متادیتا، سایت‌مپ و callback درگاه)
NEXT_PUBLIC_SITE_URL=https://zenoxweb.ir

# --- حساب مالک اولیه (این مقادیر را حتماً تنظیم کنید) ---
# در اولین اجرا، یک حساب مالک با این اطلاعات ساخته می‌شود.
# اگر تنظیم نشوند، یک حساب پیش‌فرض admin@zenoxweb.ir / Owner@12345 ساخته می‌شود
# که باید بلافاصله رمز آن را تغییر دهید.
OWNER_NAME=مدیر سایت
OWNER_EMAIL=admin@zenoxweb.ir
OWNER_PHONE=09120000000
OWNER_PASSWORD=change-this-strong-password

# درگاه پرداخت زرین‌پال — در صورت خالی بودن، درگاه آزمایشی داخلی فعال می‌شود
ZARINPAL_MERCHANT_ID=

# سرویس پیامک (کاوه‌نگار) — در صورت خالی بودن کد OTP در لاگ و UI نمایش داده می‌شود
SMS_API_KEY=
SMS_TEMPLATE=verify

# ارسال ایمیل تایید (Resend)
RESEND_API_KEY=
MAIL_FROM=noreply@zenoxweb.ir

# دیتابیس داکر
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zenoxweb
